APP_NAME="E-Voting OSIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_ALLOWED_HOSTS=localhost,127.0.0.1

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# SQLite (default, direkomendasikan untuk instalasi lokal)
DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database/database.sqlite

# MySQL (uncomment semua baris di bawah jika ingin menggunakan MySQL)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=evoting_osis
# DB_USERNAME=root
# DB_PASSWORD=

# --- Session & Cache ---
# Gunakan driver 'file' — project ini tidak membuat migration tabel session/cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
